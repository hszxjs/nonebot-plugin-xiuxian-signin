            "amount": [
              1,
              2
            ]
          }
        }
      ],
      "trap": [
        {
          "text": "青玄古门的边缘残留着上古禁制，禁制激活，气流如刃，你弃物才穿过。"
        },
        {
          "text": "边缘的青玄古门忽然，灵气暴走成漩涡，你被卷入边缘，弃物才挣脱。"
        },
        {
          "text": "青玄古门边缘的守护力量苏醒，威压降临，你以宝相挡，宝碎人存。"
        }
      ],
      "rest": [
        {
          "text": "青玄古门边缘的一处避风高地，你于此打坐，借青玄门影的气运淬炼神魂。"
        },
        {
          "text": "边缘的青玄古门灵气虽狂暴却精纯，你冒险吐纳，青玄门影之力淬炼着肉身。"
        },
        {
          "text": "你在青玄古门边缘寻一处禁制余韵庇护的空地安心调息，浊气不侵。"
        }
      ],
      "random": [
        {
          "text": "青玄古门边缘突然降下传承光柱，你沐浴其中，青玄门影的机缘灌入体内。",
